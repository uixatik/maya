# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[*.{ts,js,html,css}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{ps1,cmd,bat}]
end_of_line = crlf
