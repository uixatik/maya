{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maya",
  "version": "0.0.1",
  "identifier": "com.maya.downloader",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maya Downloader",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Uixatik",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../target/release/maya.exe": "bin/maya.exe",
      "../../../target/release/mayad.exe": "bin/mayad.exe",
      "../../../target/release/maya-nmh.exe": "bin/maya-nmh.exe",
      "../../../extensions/browser-capture": "extensions/browser-capture"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi"
      }
    }
  }
}
